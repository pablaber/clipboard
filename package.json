{
	"name": "clipboard",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"app:bootstrap": "node scripts/free-supabase-ports.mjs && supabase start --ignore-health-check -x realtime,studio,edge-runtime,logflare,vector,supavisor,imgproxy,storage-api,postgres-meta && supabase status --output env --override-name api.url=SUPABASE_URL --override-name auth.secret_key=SUPABASE_SECRET_KEY | node scripts/write-local-supabase-env.mjs",
		"db:start": "node scripts/free-supabase-ports.mjs && supabase db start",
		"db:reset": "supabase db reset",
		"db:stop": "supabase stop",
		"db:push": "supabase db push",
		"config:push": "supabase config push"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261016.1",
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"supabase": "^2.121.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0"
	}
}
